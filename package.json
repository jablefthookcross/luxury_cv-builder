{
  "name": "vitaecraft-ai-qa",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:backend": "./venv/bin/python app.py --port 5000",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:all": "playwright test",
    "test:allure": "allure generate allure-results --clean -o allure-report",
    "test:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.9.3"
  }
}
