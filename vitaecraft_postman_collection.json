    {
      "name": "💥 Admin & Nuclear Cleanup",
      "item": [
        {
          "name": "Nuklearne Czyszczenie Bazy (POST /admin/cleanup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preserve_owner\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/cleanup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "cleanup"
              ]
            },
            "description": "Usuwa wszystkie konta testowe, profile testowe, zapisane CV oraz pliki tymczasowe."
          }
        }
      ]
    },
